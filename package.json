{
  "name": "tuto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:serverless-tanstack-start-transform": "esbuild lib/serverless-tanstack-start/server-functions-transform.ts --bundle --platform=node --format=cjs --target=node22 --outfile=lib/serverless-tanstack-start/server-functions-transform.generated.cjs --external:@tanstack/start-plugin-core",
    "build:serverless-tanstack-start-runners": "node scripts/build-serverless-tanstack-start-runners.mjs",
    "build:serverless-tanstack-start-runtime": "yarn build:serverless-tanstack-start-transform && yarn build:serverless-tanstack-start-runners",
    "start": "next start",
    "lint": "eslint",
    "typecheck:tsgo": "tsgo -p tsconfig.tsgo.json --pretty false",
    "test:serverless-tanstack-start": "yarn build:serverless-tanstack-start-runtime && node --test test/serverless-tanstack-start/*.test.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/start-plugin-core": "^1.171.10",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.27.4",
    "express": "^5.2.1",
    "hono": "^4.12.8",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "motion": "^12.38.0",
    "next": "16.2.0",
    "node-pty": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rolldown": "^1.0.3",
    "secure-exec": "0.1.0",
    "vite": "^8.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "yarn@4.13.0"
}
